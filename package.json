{
  "name": "ai-tools",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "security": "node scripts/security-check.mjs",
    "security:consumers": "node scripts/consumer-security-check.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "smoke:pr-review": "node scripts/smoke-pr-review.mjs",
    "test:pr-review": "vitest run packages/secondpair"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "license": "MIT",
  "overrides": {
    "@modelcontextprotocol/sdk": {
      "@hono/node-server": "2.0.12"
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "vitest": "^4.1.10"
  }
}
