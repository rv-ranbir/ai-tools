{
  "name": "pr-review-agent",
  "version": "0.1.0",
  "description": "LLM-powered pull request reviewer with a persistent repo codemap for whole-project context",
  "type": "module",
  "bin": {
    "pr-review": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "action.yml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@octokit/rest": "^21.0.0",
    "commander": "^12.1.0",
    "picocolors": "^1.1.0",
    "typescript": "^5.6.0",
    "yaml": "^2.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "vitest": "^2.1.0"
  }
}
